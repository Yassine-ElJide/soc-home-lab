# Custom Suricata rules for the SOC home lab
# HOME_NET = 192.168.10.0/24
# sid range 1000000-1999999 is reserved for local rules.
# Test: sudo suricata -T -c /etc/suricata/suricata.yaml

# T1046: port scan, many new TCP connection attempts (SYN) from one host in a short window
alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Possible TCP port scan"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-recon; sid:1000001; rev:2;)

# T1110.003: burst of new RDP connections (brute force / spraying)
alert tcp any any -> $HOME_NET 3389 (msg:"LAB RDP Repeated connection attempts"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-user; sid:1000002; rev:2;)

# T1110.003: burst of new SMB connections (password spraying over SMB)
alert tcp any any -> $HOME_NET 445 (msg:"LAB SMB Repeated connection attempts"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 15, seconds 60; classtype:attempted-user; sid:1000003; rev:2;)

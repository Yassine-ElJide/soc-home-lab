# Custom Suricata rules for the SOC home lab
# HOME_NET = 192.168.10.0/24
# sid range 1000001+ is the local/user range.
# Test: sudo suricata -T -c /etc/suricata/suricata.yaml

# T1046 - horizontal port scan: many SYNs from one host in a short window
alert tcp $HOME_NET any -> $HOME_NET any (msg:"LAB SCAN Possible TCP port scan"; flags:S; flow:to_server; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# T1110.003 - repeated RDP connection attempts (brute force / spraying)
alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"LAB RDP Repeated connection attempts"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-dos; sid:1000002; rev:1;)

# T1110.003 - repeated SMB session setups (password spraying over SMB)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"LAB SMB Repeated session attempts"; flow:to_server; threshold:type both, track by_src, count 15, seconds 60; classtype:attempted-recon; sid:1000003; rev:1;)
